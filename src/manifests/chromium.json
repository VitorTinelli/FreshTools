{
  "manifest_version": 3,
  "name": "FreshTools",
  "version": "1.2.1",
  "description": "Um pacote de ferramentas úteis para o Freshchat",
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "FreshTools", "default_icon": { "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" } },
  "permissions": ["clipboardWrite", "webRequest", "declarativeNetRequest", "declarativeNetRequestFeedback"],
  "background": { "service_worker": "background/index.js" },
  "host_permissions": ["https://*.freshdesk.com/*", "https://*.freshchat.com/*", "https://*.freshworks.com/*", "https://*.myfreshworks.com/*", "https://*.amazonaws.com/*", "https://upload1.vocaroo.com/*", "https://upload2.vocaroo.com/*", "https://vocaroo.com/*"],
  "content_scripts": [
    { "matches": ["https://*.freshdesk.com/*", "https://*.freshchat.com/*", "https://*.freshworks.com/*", "https://*.myfreshworks.com/*"], "js": ["content/audio-url-bridge.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://*.freshdesk.com/*", "https://*.freshchat.com/*", "https://*.freshworks.com/*", "https://*.myfreshworks.com/*"], "js": ["content/index.js", "vendor/encoderWorker.umd.js", "content/audio-integrity.js", "content/vocaroo-upload.js", "content/vocaroo-feedback.js", "content/audio-recorder.js", "content/audio-player.js", "content/video-player.js"], "css": ["styles/content.css", "styles/audio-recorder.css", "styles/audio-player.css", "styles/video-player.css", "styles/vocaroo-feedback.css"], "run_at": "document_idle" }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "web_accessible_resources": [{ "resources": ["vendor/encoderWorker.umd.js", "vendor/OggOpusEncoder.wasm", "audio-worklet.js"], "matches": ["https://*.freshdesk.com/*", "https://*.freshchat.com/*", "https://*.freshworks.com/*", "https://*.myfreshworks.com/*"] }]
}
